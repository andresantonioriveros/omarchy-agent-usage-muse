#!/usr/bin/python3
# omarchy:summary=Print the Muse (Meta) usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Muse (Meta Muse Spark) local usage into one display-ready JSON record.

Pure metering, no cost estimation and no network: token counts, prompt and
session counts, per-day and per-model breakdowns. Sources (all local):
  - native `muse` CLI sessions in ~/.local/share/muse/sessions/**/session.jsonl
    (`model_completed` run events carry per-step token usage + model id),
  - opencode sessions with providerID == "meta" (any Muse Spark model),
  - opencode sessions with providerID == "opencode" whose modelID contains
    "muse-spark" (e.g. muse-spark-1.3-contributor-free via the opencode proxy).

Meta exposes no usage/billing API and no rate-limit headers, so there is no
balance or limits section — the agents panel only ever reads the JSON this
prints and renders the measured usage.
"""

import argparse
import fcntl
import hashlib
import json
import os
import re
import sqlite3
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "muse"
AGENT_NAME = "Muse"
AUTH_HELP = "Run `muse login` or set the meta API key in opencode auth.json."

# Cache schema version. Bump when the cached stats shape changes so old
# caches are rescanned instead of trusted.
CACHE_SCHEMA_VERSION = 2

# Same cache semantics as the codex collector: a scan this recent only dedups
# concurrent collector runs; --limits-only may reuse a scan for 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def number(value):
  try:
    return int(float(value or 0))
  except Exception:
    return 0


def model_name(raw):
  value = str(raw or "muse-spark").rstrip("/").split("/")[-1]
  return value if value else "muse-spark"


def local_day(value):
  """Normalize assorted timestamps to a local YYYY-MM-DD date string."""
  if value is None:
    return datetime.now().astimezone().date().isoformat()
  if isinstance(value, (int, float)):
    seconds = float(value)
    # Native muse recorded_at is microseconds; opencode created is millis;
    # codex-style seconds also possible.
    if seconds > 10_000_000_000_000:
      seconds = seconds / 1_000_000
    elif seconds > 10_000_000_000:
      seconds = seconds / 1000
    try:
      return datetime.fromtimestamp(seconds).astimezone().date().isoformat()
    except Exception:
      return datetime.now().astimezone().date().isoformat()
  text = str(value)
  try:
    if text.endswith("Z"):
      dt = datetime.fromisoformat(text[:-1] + "+00:00")
    else:
      dt = datetime.fromisoformat(text)
    if dt.tzinfo is not None:
      dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d")
  except Exception:
    return datetime.now().astimezone().date().isoformat()


now = datetime.now().astimezone()
today = now.date().isoformat()
recent_dates = [(now.date() - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
recent = {day: 0 for day in recent_dates}
today_tokens_by_model = {}
model_usage = {}
today_sessions = set()
active_days = set()

today_prompts = 0
today_total_tokens = 0
total_prompts = 0
total_sessions = set()


def add_usage(day, session_key, model, input_tokens, output_tokens, cache_read, cache_write):
  global today_prompts, today_total_tokens, total_prompts
  total = input_tokens + output_tokens + cache_read + cache_write
  if total <= 0:
    return
  total_prompts += 1
  total_sessions.add(session_key)
  active_days.add(day)

  bucket = model_usage.setdefault(model, {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  })
  bucket["inputTokens"] += input_tokens
  bucket["outputTokens"] += output_tokens
  bucket["cacheReadInputTokens"] += cache_read
  bucket["cacheCreationInputTokens"] += cache_write

  if day in recent:
    recent[day] += total
  if day == today:
    today_prompts += 1
    today_sessions.add(session_key)
    today_total_tokens += total
    today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total


def muse_sessions_root():
  return Path(os.environ.get("MUSE_DATA_DIR") or (Path.home() / ".local" / "share" / "muse")) / "sessions"


def iter_native_events(path):
  """Yield (event_dict, recorded_at) pairs from a native session.jsonl file.

  Handles both plain event lines and retained_frame wrappers whose children
  carry record_json payloads.
  """
  try:
    with path.open(errors="replace") as handle:
      for raw in handle:
        raw = raw.strip()
        if not raw:
          continue
        try:
          entry = json.loads(raw)
        except Exception:
          continue
        if not isinstance(entry, dict):
          continue
        candidates = [entry]
        children = entry.get("children")
        if isinstance(children, list):
          for child in children:
            if not isinstance(child, dict):
              continue
            nested = child.get("record_json")
            if not nested:
              continue
            try:
              parsed = json.loads(nested)
            except Exception:
              continue
            if isinstance(parsed, dict):
              candidates.append(parsed)
        for event in candidates:
          payload = event.get("payload") or {}
          if not isinstance(payload, dict):
            continue
          yield payload, event.get("recorded_at")
  except OSError:
    return


def scan_native_muse_sessions():
  root = muse_sessions_root()
  if not root.exists():
    return
  files = []
  try:
    files = [p for p in root.rglob("session.jsonl") if p.is_file()]
  except OSError:
    return
  for path in files:
    current_model = ""
    try:
      mtime_day = local_day(path.stat().st_mtime)
    except OSError:
      mtime_day = today
    for payload, recorded_at in iter_native_events(path):
      kind = payload.get("kind")
      if kind == "metadata":
        record = payload.get("record") or {}
        if isinstance(record, dict) and record.get("model_id"):
          current_model = model_name(record.get("model_id"))
        continue
      if kind == "run_model":
        record = payload.get("record") or {}
        if isinstance(record, dict) and record.get("model_id"):
          current_model = model_name(record.get("model_id"))
        continue
      if kind != "run":
        continue
      event = payload.get("event") or {}
      if not isinstance(event, dict):
        continue
      if event.get("kind") != "model_completed":
        continue
      usage = event.get("usage") or {}
      if not isinstance(usage, dict):
        continue
      model = model_name(event.get("model") or current_model)
      input_tokens = number(usage.get("input_tokens"))
      # Reasoning tokens are generated tokens: count them as output.
      output_tokens = number(usage.get("output_tokens")) + number(usage.get("reasoning_tokens"))
      cache_read = number(usage.get("cache_read_tokens", usage.get("cached_tokens")))
      cache_write = number(usage.get("cache_write_tokens"))
      # Cached tokens are a subset of input: keep the split without double
      # counting (same convention as the codex collector).
      input_tokens = max(0, input_tokens - cache_read - cache_write)
      if not (input_tokens or output_tokens or cache_read or cache_write):
        continue
      day = local_day(recorded_at) if recorded_at else mtime_day
      # Subagent trees roll up into their parent session: normalize both the
      # main session.jsonl and any subagent/.../session.jsonl to the session
      # directory, so one user session counts once however many subagents
      # it spawned.
      session_key = "muse:" + re.sub(r"(/subagent/.*)?/session\.jsonl$", "", str(path))
      add_usage(day, session_key, model,
                input_tokens, output_tokens, cache_read, cache_write)


def scan_opencode_sessions():
  """opencode rows for meta provider Muse models + opencode-proxied muse-spark.

  Returns True when the scan ran to completion (safe to cache).
  """
  db = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "opencode.db"
  if not db.is_file():
    return True
  try:
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error:
    return False
  try:
    conn.execute("PRAGMA query_only = ON")
    # LIKE gates are pure acceleration (see the codex collector for the full
    # rationale); the Python exact-match filter below is the authority.
    query = (
      "SELECT session_id, data FROM message"
      " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
      " AND (data LIKE '%\"providerID\"%:%\"meta\"%' OR data LIKE '%muse-spark%')"
      " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
    )
    for session_id, raw in conn.execute(query):
      try:
        entry = json.loads(raw)
        if not isinstance(entry, dict) or entry.get("role") != "assistant":
          continue
        provider = str(entry.get("providerID") or "")
        model = model_name(entry.get("modelID"))
        if provider == "meta":
          pass  # any meta model counts (muse-spark 1.1/1.2/1.3, ...)
        elif provider == "opencode" and "muse-spark" in model.lower():
          pass  # opencode-proxied Muse Spark (e.g. 1.3-contributor-free)
        else:
          continue
        tokens = entry.get("tokens") or {}
        cache = tokens.get("cache") or {}
        # opencode reports input exclusive of cache: keep the token buckets
        # separate, no subtraction.
        input_tokens = number(tokens.get("input"))
        output_tokens = number(tokens.get("output")) + number(tokens.get("reasoning"))
        cache_read = number(cache.get("read"))
        cache_write = number(cache.get("write"))
        if not (input_tokens or output_tokens or cache_read or cache_write):
          continue
        created = (entry.get("time") or {}).get("created")
        day = local_day(created)
        add_usage(day, "opencode:" + str(session_id), model,
                  input_tokens, output_tokens, cache_read, cache_write)
      except Exception:
        continue
  except sqlite3.Error:
    return False
  finally:
    try:
      conn.close()
    except Exception:
      pass
  return True


def cache_root():
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def scan_cache_paths():
  db = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "opencode.db"
  digest = hashlib.sha1(
    (str(Path.home()) + "\n" + str(muse_sessions_root()) + "\n" + str(db)).encode("utf-8")
  ).hexdigest()[:16]
  root = cache_root()
  return root / f"muse-scan-{digest}.json", root / f"muse-scan-{digest}.lock"


def read_fresh_json(path, max_age_seconds):
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path, payload):
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_cached_stats(cache_file, max_age_seconds):
  cached = read_fresh_json(cache_file, max_age_seconds)
  if not isinstance(cached, dict) or cached.get("schemaVersion") != CACHE_SCHEMA_VERSION:
    return None
  if cached.get("scanDate") != today:
    return None
  stats = cached.get("stats")
  if not isinstance(stats, dict):
    return None
  required = ("todayPrompts", "todayTotalTokens", "recentDays", "activeDates",
              "modelUsage")
  if not all(key in stats for key in required):
    return None
  return stats


def write_cached_stats(cache_file, stats):
  try:
    write_json(cache_file, {"schemaVersion": CACHE_SCHEMA_VERSION, "scanDate": today, "stats": stats})
  except Exception as exc:
    print(f"omarchy-agent-usage-muse: could not write usage cache ({exc})", file=sys.stderr)


def local_stats():
  return {
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_total_tokens,
    "todayTokensByModel": today_tokens_by_model,
    "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_dates],
    "totalPrompts": total_prompts,
    "totalSessions": len(total_sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": model_usage,
  }


def restore_cached_stats(stats):
  """Restore module-level aggregates from a cached stats dict."""
  global today_prompts, today_total_tokens, total_prompts
  global today_tokens_by_model, model_usage, recent
  global today_sessions, total_sessions, active_days
  today_prompts = number(stats.get("todayPrompts"))
  today_sessions = set(stats.get("todaySessionsList", []))
  today_total_tokens = number(stats.get("todayTotalTokens"))
  today_tokens_by_model = dict(stats.get("todayTokensByModel") or {})
  for row in stats.get("recentDays") or []:
    if isinstance(row, dict) and row.get("date") in recent:
      recent[row["date"]] = number(row.get("messageCount"))
  total_prompts = number(stats.get("totalPrompts"))
  total_sessions = set(stats.get("totalSessionsList", []))
  active_days = set(stats.get("activeDates") or [])
  model_usage = dict(stats.get("modelUsage") or {})
  # Session identity sets cannot be rehydrated from counts alone; persist them
  # explicitly so a cached run reports the same session counts.
  return stats


def run_local_scans():
  scan_native_muse_sessions()
  complete = scan_opencode_sessions()
  return local_stats(), complete


def cached_local_stats(max_age):
  try:
    return _cached_local_stats(max_age)
  except Exception as exc:
    print(f"omarchy-agent-usage-muse: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    stats, _ = run_local_scans()
    return stats


def _cached_local_stats(max_age):
  cache_file, lock_file = scan_cache_paths()
  cached = read_cached_stats(cache_file, max_age)
  if cached is not None:
    return restore_cached_stats(cached)
  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    cached = read_cached_stats(cache_file, max_age)
    if cached is not None:
      return restore_cached_stats(cached)
    stats, complete = run_local_scans()
    if complete:
      # Session sets are needed for counts; stash them alongside the stats.
      stats["todaySessionsList"] = sorted(today_sessions)
      stats["totalSessionsList"] = sorted(total_sessions)
      write_cached_stats(cache_file, stats)
    return stats


def muse_authenticated():
  auth = Path.home() / ".config" / "muse" / "auth.json"
  if auth.is_file():
    return True
  try:
    raw = (Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
           / "opencode" / "auth.json").read_text(encoding="utf-8")
    parsed = json.loads(raw)
    return isinstance(parsed, dict) and "meta" in parsed
  except Exception:
    return False


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  stats = cached_local_stats(max_age)

  authed = muse_authenticated()
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": number(stats.get("totalPrompts")) > 0,
    "hasLocalStats": True,
    # Prompts and sessions are counted, so the panel shows them in tooltips.
    "hasPromptStats": True,
    "todayPrompts": number(stats.get("todayPrompts")),
    "todaySessions": number(stats.get("todaySessions", len(today_sessions))),
    "todayTotalTokens": number(stats.get("todayTotalTokens")),
    "todayTokensByModel": stats.get("todayTokensByModel") or {},
    "recentDays": stats.get("recentDays") or [],
    "totalPrompts": number(stats.get("totalPrompts")),
    "totalSessions": number(stats.get("totalSessions", len(total_sessions))),
    "activeDays": number(stats.get("activeDays")),
    "activeDates": stats.get("activeDates") or [],
    "modelUsage": stats.get("modelUsage") or {},
    # Static billing-model label (not measured, not estimated): Muse Spark
    # is prepaid credits, so the hero reads PREPAID instead of SUBSCRIPTION.
    "tierLabel": "Prepaid",
    # No rate-limit endpoint is known for the Meta API; auth problems
    # surface in usageStatusText instead of a limits probe.
    "limits": [],
    "usageStatusText": "" if (authed or number(stats.get("totalPrompts")) > 0) else "Muse unavailable",
    "authHelpText": "" if authed else AUTH_HELP,
  }
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))


if __name__ == "__main__":
  raise SystemExit(main())
